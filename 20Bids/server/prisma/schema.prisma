generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String      // Hashed password
  name         String?
  avatarUrl    String?
  settings     Json?
  plan         Plan        @default(FREE)
  planRenewsAt DateTime?
  // True while a PRO subscription is set to lapse at period end (user hit
  // "cancel" in the Stripe portal but still has paid-up access). The app
  // shows "Canceled · access until <date>" instead of "Renews <date>".
  planCancelAtPeriodEnd Boolean @default(false)
  // Internal testers (us). Gates the Profile "Tester" tools (free PRO toggle,
  // demo data) and the /auth/upgrade freebie. Regular users can't self-grant
  // PRO — they go through Stripe/Apple.
  isTester     Boolean     @default(false)
  riskProfile  Json?       // { mvso, vol, min, sl, notifications }
  // --- Optional profile fields (added 2026-07-27). All nullable: they are
  // conveniences, and nothing in the product may require them.
  company      String?
  jobTitle     String?
  country      String?
  phone        String?
  timezone     String?     // IANA zone; the product quotes ET everywhere today
  stripeCustomerId     String?  @unique   // Stripe Customer id (cus_...)
  stripeSubscriptionId String?            // active subscription id (sub_...)
  createdAt    DateTime    @default(now())
  tags         Tag[]
  watchlist    Watchlist[]
  reveals      Reveal[]
  notes        Note[]
  pushTokens   PushToken[]
}

// One per device per user. We upsert by token (a single Expo token can only
// belong to one user at a time — if a user logs out and another logs in on
// the same device, the row gets re-assigned to the new userId).
model PushToken {
  id         String    @id @default(uuid())
  token      String    @unique // "ExponentPushToken[xxxxx]"
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform   String    // "ios" | "android"
  deviceName String?
  appVersion String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @updatedAt

  @@index([userId])
}

// Idempotency guard: prevents sending the same broadcast more than once
// per (kind, date). When /api/external/ingest is called multiple times on
// the same day for refreshes, only the FIRST one fires the push.
model BroadcastLog {
  id        String   @id @default(uuid())
  kind      String   // "morning_bids" | future kinds
  date      DateTime @db.Date
  count     Int      // how many tokens received the broadcast
  createdAt DateTime @default(now())

  @@unique([kind, date])
}

enum Plan {
  FREE
  PRO
}

// Password reset codes (6-digit numeric) sent via email by /auth/forgot-password.
// We store the HASH of the code, never the code itself — same principle as
// passwords. One active code per email; a new request invalidates the prior.
// Codes expire after 60 minutes. After max 5 failed attempts the row is
// cleared to prevent brute force.
model PasswordResetToken {
  id         String   @id @default(uuid())
  email      String   @unique   // lookup by email; one active token per email
  codeHash   String              // bcrypt hash of the 6-digit code
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

// Tracks per-day ticker reveals for FREE plan users (1 reveal/day cap).
model Reveal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  symbol    String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, symbol, date])
  @@index([userId, date])
}

// User-private notes pinned to a ticker symbol (one per symbol per user).
model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  symbol    String
  body      String
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
}

model Recommendation {
  id            String   @id @default(uuid())
  symbol        String
  name          String
  date          DateTime
  // ⚠️ `price` holds the 09:30 OPEN on rows written by the CSV backfill
  // (index.ts wrote `price: open`). It is NOT a close and must never be used
  // as a backtest exit — use closePost1020 below.
  price         Float     // Real-time price today; 09:30 OPEN on historical rows
  open          Float     @default(0) // Opening price
  high          Float     @default(0) // High price
  refPrice1020  Float?    // Reference price at 10:20 AM
  lowBeforePeak Float?    // Lowest price between 10:20 and the daily High
  refPrice1120  Float?    // Reference price at 11:20 AM
  highPost1120  Float?    // Max Excursion after 11:20 AM
  refPrice1220  Float?    // Reference price at 12:20 PM
  highPost1220  Float?    // Max Excursion after 12:20 PM
  // --- Backtest-grade waypoints (added 2026-07) ---------------------------
  closePost1020 Float?    // TRUE post-10:20 regular-session close (the honest exit)
  lowAfterPeak  Float?    // Lowest low AFTER the peak — detects post-peak stops
  peakAt        DateTime? // Minute of the post-10:20 peak (unlocks time-to-target)
  firstCross    Json?     // { "0.5": minutesAfterEntry, "1": …, "2": … }
  maeBeforeCross Json?    // level -> max adverse excursion (%) BEFORE that level was touched
  entryPath     Json?     // { "5": price, "10": …, … "30": … } — minutes after 10:20; lets the client sim price a DELAYED entry
  low30         Float?    // Lowest low in the 30 min after 10:20 — decides whether a below-ref LIMIT order ever fills
  high30        Float?    // Highest high in the same window
  // --- Market context (added 2026-07-27) ----------------------------------
  // Backfilled by scripts/backfill_market_context.ts. All nullable: a symbol
  // Polygon has no history for keeps NULL and the charts drop it rather than
  // treating a missing value as a zero.
  atrPct        Float?    // ATR(14) over the 14 sessions BEFORE, as % of prior close
  gapPct        Float?    // (open − prior close) / prior close × 100
  rvol1020      Float?    // vol 09:30–10:20 ÷ mean of the same window over 20 prior sessions
  spyDayPct     Float?    // SPY's return that session — the tape the pick ran in
  changePercent Float
  volume        Float
  relativeVol   Float
  marketCap     Float
  sector        String
  type          String
  probability   String
  probabilityValue Int @default(70)
  time          String
  stopLoss      Float
  priceTarget   Float
  thesis        String
  catalyst      String?
  rsi           Float
  beta          Float
  earningsDate  String?
  analystRating String
  sentiment     String

  // [STANDBY] Live IBKR Sync Data (Hybrid Architecture)
  // Uncomment these fields AND the webhook in index.ts when ready to use.
  // Also run: npx prisma db push --accept-data-loss
  // ibkrPosition      Int?     @default(0)
  // ibkrAvgCost       Float?   @default(0)
  // ibkrUnrealizedPNL Float?   @default(0)

  @@unique([symbol, date])
}

// Issuer-level reference data from Polygon /v3/reference/tickers/{symbol}.
// Keyed by symbol and deliberately NOT hung off Recommendation: a description
// belongs to the company, not to a session, so a column on Recommendation
// would store the same 300-word paragraph once per bid per day (~250 copies
// for a symbol that recurs for a year) and would have to be re-fetched on
// every new bid. One row per symbol, fetched once, read by every bid.
//
// No FK from Recommendation.symbol: this table is filled lazily by the
// backfill, so a constraint would reject every existing recommendation whose
// issuer hasn't been fetched yet. The join is a symbol lookup in the route.
model Company {
  symbol         String    @id             // "AAPL" — same string Recommendation.symbol holds
  name           String?                   // Polygon `results.name`, for reconciling renames
  // FULL Polygon paragraph. Trimming happens at the response boundary
  // (shortDescription in services/polygon.ts) so the UI's "2–3 sentences"
  // rule can change without re-fetching the whole universe.
  description    String?
  homepageUrl    String?
  totalEmployees Int?
  listDate       DateTime? @db.Date        // IPO/list date; Polygon sends "YYYY-MM-DD"
  // Last time Polygon ANSWERED, whether or not it had a description. ETFs and
  // many small caps have none; without this the backfill would re-request
  // those symbols on every run forever.
  fetchedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  symbol    String
  color     String
  
  @@unique([userId, symbol])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  symbol    String
  
  @@unique([userId, symbol])
}

// Trading automation configuration
model TradingConfig {
  id                   Int      @id @default(autoincrement())
  takeProfit           Float    @default(3.0)      // Take profit %
  stopLoss             Float    @default(5.0)      // Stop loss %
  maxStocks            Int      @default(10)       // Max stocks to trade
  maxPositionPercent   Float    @default(20.0)     // Max % of portfolio per position
  maxDailySpend        Float    @default(32500)    // Max daily spend in USD (~30K€)
  minVolume            Float    @default(2000000)  // Min volume filter (2M)
  minPrice             Float    @default(5.0)      // Min price filter
  maxGainSkip          Float    @default(1.0)      // Skip if already gained >X%
  prioritizeBelowRef   Boolean  @default(true)     // Prioritize stocks below refPrice1020
  retryIntervalMinutes Int      @default(1)        // Retry interval if no data
  maxRetries           Int      @default(10)       // Max retry attempts
  executionHour        Int      @default(10)       // Hour to execute (ET)
  executionMinute      Int      @default(25)       // Minute to execute (ET)
  enabled              Boolean  @default(false)    // Auto-trading enabled
  updatedAt            DateTime @updatedAt
}

// Log of executed trades
model TradeLog {
  id              String   @id @default(uuid())
  symbol          String
  quantity        Int
  entryPrice      Float
  takeProfitPrice Float
  stopLossPrice   Float
  parentOrderId   Int
  tpOrderId       Int
  slOrderId       Int
  status          String   @default("SUBMITTED") // SUBMITTED, FILLED, CANCELLED, ERROR
  errorMessage    String?
  executedAt      DateTime @default(now())
}
